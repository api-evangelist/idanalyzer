{
  "opencollection": "1.0.0",
  "info": {
    "name": "ID Analyzer Scanner Account API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.idanalyzer.com/myaccount"
          },
          "docs": "Retrieve the current account's profile, quota, and usage statistics."
        }
      ]
    }
  ],
  "bundled": true
}